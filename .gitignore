# ---------- 构建产物 ----------
*.apk
*.aab
*.dex
*.class
build/
release/
out/
.gradle/

# ---------- 本地环境配置（含本机 SDK 绝对路径，不可公开）----------
local.properties

# ---------- 本地工具链：JDK / Android SDK / Gradle（约 900MB，绝不上传）----------
tools/

# ---------- 发布包与归档（改用 GitHub Releases 分发）----------
/EGOPD_*.APK
/EGOPD_*.jar
*.zip

# ---------- 日志 ----------
*.log

# ---------- 临时文件 ----------
tmp_*
*.tmp

# ---------- 核验脚本的补丁备份（可随时重新生成）----------
_bak_*

# ---------- IDE ----------
*.iml
.idea/
.vscode/

# ---------- 操作系统杂项 ----------
Thumbs.db
Desktop.ini
.DS_Store
